{
  "name": "meditation-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "setup:env": "sh ./scripts/update-local-ip.sh",
    "docker:build": "npm run setup:env && docker compose build",
    "docker:start": "npm run setup:env && docker compose up --build",
    "docker:rebuild": "npm run setup:env && docker compose down && docker compose build --no-cache && docker compose up",
    "docker:down": "docker compose down",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.9",
    "expo-constants": "~18.0.13",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "~0.21.0",
    "@expo/metro-runtime": "^6.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "19.1.10",
    "typescript": "^5.3.0"
  },
  "private": true
}
